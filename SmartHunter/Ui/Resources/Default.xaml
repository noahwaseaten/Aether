<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:pfComponentModel="clr-namespace:System.ComponentModel;assembly=PresentationFramework"
                    xmlns:wbComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"

                    xmlns:converters="clr-namespace:SmartHunter.Ui.Converters"
                    xmlns:behaviors="clr-namespace:SmartHunter.Ui.Behaviors"
                    xmlns:helpers="clr-namespace:SmartHunter.Core.Helpers"
                    xmlns:controls="clr-namespace:SmartHunter.Ui.Controls"
                    xmlns:coreData="clr-namespace:SmartHunter.Core.Data"
                    xmlns:data="clr-namespace:SmartHunter.Game.Data"
                    xmlns:widgetContexts="clr-namespace:SmartHunter.Game.Data.WidgetContexts"
                    xmlns:Windows="clr-namespace:SmartHunter.Ui.Windows"
                    xmlns:viewModels="clr-namespace:SmartHunter.Game.Data.ViewModels"

                    xmlns:oxy="http://oxyplot.org/wpf"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    mc:Ignorable="d"
>
    <!--
        SmartHunter "Modern" skin
        Dark glass cards, eased bars with a damage ghost trail, quiet enter/exit motion.
        Tweak the palette below; everything else derives from it.
    -->

    <!--Converters-->
    <converters:AngleToIsLargeArcConverter x:Key="A_Converter_AngleToIsLargeArc" />
    <converters:AngleToPointConverter x:Key="A_Converter_AngleToPoint" />
    <converters:PlayerToPlayerIndexConverter x:Key="A_Converter_PlayerToPlayerIndex" />
    <converters:FractionToPercentageConverter x:Key="A_Converter_FractionToPercentage" />
    <converters:BoolToVisibilityConverter x:Key="A_Converter_BoolToVisibility" />
    <converters:LocalizerConverter x:Key="A_Converter_Localizer" />
    <converters:NumberComparisonConverter x:Key="A_Converter_NumberGreater" Comparison="Greater" />
    <converters:NumberComparisonConverter x:Key="A_Converter_NumberNotEqual" Comparison="NotEqual" />
    <converters:EnumComparisonConverter x:Key="A_Converter_EnumComparison" />
    <converters:StringFormatConverter x:Key="A_Converter_StringFormat" />
    <converters:NumberToCenteredMarginConverter x:Key="A_Converter_NumberToCenteredMargin" />
    <converters:WeaponTypeToNameConverter x:Key="A_Converter_WeaponTypeToName" />
    <converters:IconKeyToImageConverter x:Key="A_Converter_IconKeyToImage" />
    <converters:SecondsToClockConverter x:Key="A_Converter_SecondsToClock" />
    <converters:MultiplyConverter x:Key="A_Converter_Multiply" />
    <converters:IsNotNullConverter x:Key="A_Converter_IsNotNull" />
    <converters:MonsterIconConverter x:Key="A_Converter_MonsterIcon" />
    <converters:FractionToOffsetConverter x:Key="A_Converter_FractionToOffset" />

    <!--Palette-->
    <Color x:Key="A_Color_Widget_Background">#00000000</Color>
    <system:Double x:Key="A_Double_Widget_Opacity">1</system:Double>

    <Color x:Key="C_Surface">#E60D1015</Color>
    <Color x:Key="C_SurfaceRaised">#F2161A21</Color>
    <Color x:Key="C_Stroke">#1FFFFFFF</Color>
    <Color x:Key="C_Track">#1AFFFFFF</Color>
    <Color x:Key="C_Text">#F3EDE0</Color>
    <Color x:Key="C_TextMuted">#B3AA97</Color>
    <Color x:Key="C_Ghost">#99FFFFFF</Color>
    <Color x:Key="C_Accent">#E2C27A</Color>
    <Color x:Key="C_Danger">#FF4D5A</Color>

    <Color x:Key="A_Color_Player_0">#E5484D</Color>
    <Color x:Key="A_Color_Player_1">#4C8DFF</Color>
    <Color x:Key="A_Color_Player_2">#F5C542</Color>
    <Color x:Key="A_Color_Player_3">#3DD68C</Color>

    <Color x:Key="A_Color_Monster_Bar">#E5484D</Color>
    <Color x:Key="A_Color_Monster_Bar_End">#FF7A59</Color>
    <Color x:Key="A_Color_Monster_Part_Bar">#E5484D</Color>
    <Color x:Key="A_Color_Monster_Part_Soften_Bar">#7EE7FC</Color>
    <Color x:Key="A_Color_Monster_StatusEffect_Bar">#2EC4B6</Color>
    <Color x:Key="A_Color_Monster_StatusEffect_Active">#F5C542</Color>

    <Color x:Key="A_Color_PlayerStatusEffect_Group_Horn">#FFD08A</Color>
    <Color x:Key="A_Color_PlayerStatusEffect_Group_Coral">#8FB8FF</Color>
    <Color x:Key="A_Color_PlayerStatusEffect_Group_Debuff">#FF7A7A</Color>
    <Color x:Key="A_Color_PlayerStatusEffect_Group_Buff">#9BE59B</Color>
    <Color x:Key="A_Color_PlayerStatusEffect_Group_Equipment">#F2F4F7</Color>
    <Color x:Key="A_Color_PlayerStatusEffect_Group_Weapon">#F2F4F7</Color>

    <Color x:Key="A_Color_Crown_Mini_Body">#E9C46A</Color>
    <Color x:Key="A_Color_Crown_Mini_Gem">#3DD68C</Color>
    <Color x:Key="A_Color_Crown_Gold_Body">#F5C542</Color>
    <Color x:Key="A_Color_Crown_Gold_Gem">#E5484D</Color>
    <Color x:Key="A_Color_Crown_Silver_Body">#D7DCE3</Color>
    <Color x:Key="A_Color_Crown_Silver_Gem">#E5484D</Color>

    <SolidColorBrush x:Key="B_Surface" Color="{StaticResource C_Surface}" />
    <SolidColorBrush x:Key="B_SurfaceRaised" Color="{StaticResource C_SurfaceRaised}" />
    <SolidColorBrush x:Key="B_Stroke" Color="{StaticResource C_Stroke}" />
    <SolidColorBrush x:Key="B_Track" Color="{StaticResource C_Track}" />
    <SolidColorBrush x:Key="B_Text" Color="{StaticResource C_Text}" />
    <SolidColorBrush x:Key="B_TextMuted" Color="{StaticResource C_TextMuted}" />
    <SolidColorBrush x:Key="B_Ghost" Color="{StaticResource C_Ghost}" />
    <SolidColorBrush x:Key="B_Accent" Color="{StaticResource C_Accent}" />
    <SolidColorBrush x:Key="B_Danger" Color="{StaticResource C_Danger}" />
    <SolidColorBrush x:Key="B_Warn" Color="#FFC857" />
    <SolidColorBrush x:Key="B_Player0" Color="{StaticResource A_Color_Player_0}" />
    <SolidColorBrush x:Key="B_Player1" Color="{StaticResource A_Color_Player_1}" />
    <SolidColorBrush x:Key="B_Player2" Color="{StaticResource A_Color_Player_2}" />
    <SolidColorBrush x:Key="B_Player3" Color="{StaticResource A_Color_Player_3}" />
    <!--Gold hairline that fades out, like the game's menu dividers-->
    <LinearGradientBrush x:Key="B_Hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#CCE2C27A" Offset="0" />
        <GradientStop Color="#33E2C27A" Offset="0.7" />
        <GradientStop Color="#00E2C27A" Offset="1" />
    </LinearGradientBrush>
    <!--Readability without a box: darkness that melts into the scene-->
    <LinearGradientBrush x:Key="B_Scrim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#A6000000" Offset="0.06" />
        <GradientStop Color="#99000000" Offset="0.88" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B_ScrimRight" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#A6000000" Offset="0.06" />
        <GradientStop Color="#99000000" Offset="0.88" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <!--Feathers the scrim's top and bottom so there is no box edge anywhere-->
    <LinearGradientBrush x:Key="B_ScrimFeather" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.14" />
        <GradientStop Color="#FF000000" Offset="0.86" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="B_DangerGlow">
        <GradientStop Color="#CCFF4D5A" Offset="0" />
        <GradientStop Color="#00FF4D5A" Offset="1" />
    </RadialGradientBrush>
    <!--Soft halo under all overlay text and icons, the way the game separates HUD from scene-->
    <DropShadowEffect x:Key="A_Effect_Halo" ShadowDepth="0" BlurRadius="5" Opacity="0.9" Color="Black" RenderingBias="Performance" />
    <SolidColorBrush x:Key="B_Part" Color="{StaticResource A_Color_Monster_Part_Bar}" />
    <SolidColorBrush x:Key="B_Soften" Color="{StaticResource A_Color_Monster_Part_Soften_Bar}" />
    <SolidColorBrush x:Key="B_Status" Color="{StaticResource A_Color_Monster_StatusEffect_Bar}" />
    <SolidColorBrush x:Key="B_StatusActive" Color="{StaticResource A_Color_Monster_StatusEffect_Active}" />
    <LinearGradientBrush x:Key="B_MonsterHealth" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource A_Color_Monster_Bar}" Offset="0" />
        <GradientStop Color="{StaticResource A_Color_Monster_Bar_End}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B_Stamina" Color="#F6A522" />

    <!--Kept for older window markup-->
    <SolidColorBrush x:Key="A_Brush_DropShadow" Color="#88000000" />
    <TranslateTransform x:Key="A_Transform_DropShadow" X="1" Y="1" />

    <!--Typography-->
    <FontFamily x:Key="Roboto">pack://application:,,,/Ui/Fonts/#Roboto</FontFamily>

    <!--Overlay text is SharpText (DirectWrite), not TextBlock: WPF's own text was soft and low in contrast over the
        game. Static Segoe UI: the variable one doesn't load its weights everywhere.-->
    <Style x:Key="A_Style_TextBlock_Base" TargetType="{x:Type controls:SharpText}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B_Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="A_Style_TextBlock_Heading" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="A_Style_TextBlock_Standard" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="A_Style_TextBlock_Standard_Centered" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Standard}">
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!--Section labels: sentence case and calm, no small gold capitals (eyebrows). Colour carries meaning only where it's set.-->
    <Style x:Key="T_Label" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B_TextMuted}" />
    </Style>
    <Style x:Key="T_Body" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="T_Big" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="T_Muted" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B_TextMuted}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="T_Value" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!--Surfaces-->
    <Style x:Key="A_Style_Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource B_Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource B_Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14 12 14 12" />
    </Style>

    <!--Scrim lives behind the content as its own feathered layer; content stays fully opaque-->
    <Style x:Key="A_Style_Scrim" TargetType="{x:Type Border}" />

    <Style x:Key="A_Style_Track" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource B_Track}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!--Gauge (Ui/Controls/Gauge.cs): HunterPie's bar. A dark trough so the game doesn't show through, a border, and a
        light line every 10% that reads on the fill and on the trough alike.-->
    <SolidColorBrush x:Key="B_GaugeTrough" Color="#D9191C1E" />
    <SolidColorBrush x:Key="B_GaugeBorder" Color="#FF2C3033" />
    <SolidColorBrush x:Key="B_GaugeLine" Color="#803A3E40" />
    <ControlTemplate x:Key="A_Template_Gauge" TargetType="{x:Type Control}">
        <UniformGrid Rows="1" Columns="10" IsHitTestVisible="False">
            <Border />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
                <Border BorderBrush="{StaticResource B_GaugeLine}" BorderThickness="1 0 0 0" />
        </UniformGrid>
    </ControlTemplate>

    <!--Edit mode: the frame, tab and grip are Core/Windows/EditChrome.cs-->
    <!--Edit mode placeholder: reserves a widget's full size and says what goes there-->
    <Style x:Key="A_Style_EditPreview" TargetType="{x:Type Grid}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanManipulateWindows}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="A_Style_EditPreviewOutline" TargetType="{x:Type Rectangle}">
        <Setter Property="Stroke" Value="{StaticResource B_Accent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="4 4" />
        <Setter Property="RadiusX" Value="8" />
        <Setter Property="RadiusY" Value="8" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Fill" Value="#33000000" />
    </Style>
    <Style x:Key="T_EditPreview" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B_TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <!--At the bottom of the reserved space: in the middle it drew through whatever the widget was showing-->
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="16 4 16 10" />
    </Style>

    <!--Danger: three red blinks, then it stays lit. Targets an element named Danger.
        Endless pulses keep the transparent overlay re-compositing every frame, which costs CPU the game could use.-->
    <Storyboard x:Key="A_Storyboard_Danger" RepeatBehavior="3x" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetName="Danger" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!--Motion: short, eased, never bouncy. Targets a FrameworkElement named Root with a TranslateTransform.-->
    <CubicEase x:Key="E_Out" EasingMode="EaseOut" />
    <CubicEase x:Key="E_In" EasingMode="EaseIn" />

    <Storyboard x:Key="A_Storyboard_Show">
        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Visibility)">
            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
        </ObjectAnimationUsingKeyFrames>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource E_Out}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource E_Out}" />
    </Storyboard>

    <Storyboard x:Key="A_Storyboard_Hide">
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource E_In}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.18" EasingFunction="{StaticResource E_In}" />
        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Visibility)">
            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
        </ObjectAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="A_Storyboard_Player_StatusEffect_Show">
        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Visibility)">
            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
        </ObjectAnimationUsingKeyFrames>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource E_Out}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-12" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource E_Out}" />
    </Storyboard>

    <Storyboard x:Key="A_Storyboard_Player_StatusEffect_Hide">
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource E_In}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-8" Duration="0:0:0.2" EasingFunction="{StaticResource E_In}" />
        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Visibility)">
            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
        </ObjectAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="A_Storyboard_StatusEffect_Active" RepeatBehavior="3x" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetName="ActiveDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!--Graphics-->
    <DataTemplate x:Key="A_DataTemplate_CircleProgress" DataType="{x:Type coreData:Progress}">
        <Viewbox>
            <Grid Width="14" Height="14">
                <Ellipse Width="12" Height="12" StrokeThickness="2" Stroke="{StaticResource B_Track}" />
                <Canvas Width="0" Height="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="-5" Y="-5" />
                    </Canvas.RenderTransform>
                    <Path StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="5,0">
                                    <ArcSegment SweepDirection="Clockwise" Size="5,5"
                                                Point="{Binding Angle, ConverterParameter=5, Converter={StaticResource A_Converter_AngleToPoint}}"
                                                IsLargeArc="{Binding Angle, Converter={StaticResource A_Converter_AngleToIsLargeArc}}" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Canvas>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <!--The same ring with a hairline stroke, around an icon-->
    <DataTemplate x:Key="A_DataTemplate_ThinRing" DataType="{x:Type coreData:Progress}">
        <Viewbox>
            <Grid Width="14" Height="14">
                <Ellipse Width="13" Height="13" StrokeThickness="1" Stroke="{StaticResource B_Track}" />
                <Canvas Width="0" Height="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="-6" Y="-6" />
                    </Canvas.RenderTransform>
                    <Path StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="6,0">
                                    <ArcSegment SweepDirection="Clockwise" Size="6,6"
                                                Point="{Binding Angle, ConverterParameter=6, Converter={StaticResource A_Converter_AngleToPoint}}"
                                                IsLargeArc="{Binding Angle, Converter={StaticResource A_Converter_AngleToIsLargeArc}}" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Canvas>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="A_Graphic_Crown">
        <Viewbox>
            <Canvas Width="512" Height="512">
                <Path Data="M40.311,448.561L471.688,448.561C480.525,448.561,487.687,441.398,487.687,432.562L487.687,350.881C487.687,342.046,480.523,334.882,471.687,334.882L40.311,334.882C31.475,334.882,24.311,342.045,24.311,350.881L24.311,432.562C24.311,441.397,31.475,448.561,40.311,448.561z" Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" />
                <Path Data="M483.949,100.035L373.852,225.934 269.275,70.501C262.941,61.088,249.062,61.085,242.725,70.501L138.148,225.934 28.051,100.035C17.811,88.327,-1.473,96.733,0.089,112.178L24.311,351.689 24.311,366.882 487.686,366.882 487.686,351.689 511.909,112.178C513.474,96.729,494.186,88.329,483.949,100.035z" Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" />
                <Ellipse Canvas.Left="204" Canvas.Top="204.5" Width="104" Height="104" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>


    <!--Monster Widget, styled after the game's own HUD: portrait, health, an ailment strip with the game's icons,
        and compact part cells. Only what's showing is in the lists, so nothing leaves a gap.-->

    <Style x:Key="T_MonsterName" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="T_Cell" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="T_CellValue" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B_TextMuted}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Margin" Value="4 0 0 0" />
    </Style>
    <Style x:Key="A_Style_Chip" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6 1 6 1" />
        <Setter Property="Margin" Value="6 0 0 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="T_Chip" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <ItemsPanelTemplate x:Key="A_Panel_Wrap">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!--New rows ease in. Lists only hold what's showing, so leaving is instant and leaves no gap.-->
    <Storyboard x:Key="A_Storyboard_CellIn">
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource E_Out}" />
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource E_Out}" />
    </Storyboard>

    <!--Ailment gauge: the ring fills with buildup; while active it turns gold and counts down-->
    <DataTemplate DataType="{x:Type data:MonsterStatusEffect}">
        <StackPanel x:Name="Root" Width="64" Margin="0 8 2 0">
            <StackPanel.RenderTransform>
                <TranslateTransform />
            </StackPanel.RenderTransform>
            <Grid Width="40" Height="40">
                <Ellipse Fill="#CC101114" />
                <ContentControl x:Name="Ring" Content="{Binding Buildup}" ContentTemplate="{StaticResource A_DataTemplate_CircleProgress}" Foreground="{StaticResource B_Status}" />
                <Image x:Name="Icon" Source="{Binding IconKey, Converter={StaticResource A_Converter_IconKeyToImage}, ConverterParameter=Trim}" Width="18" Height="18" />
                <controls:SharpText x:Name="Initials" Text="{Binding Initials}" Style="{StaticResource T_Chip}" FontSize="13" HorizontalAlignment="Center" Visibility="Collapsed" />
                <Border x:Name="Timer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 -7" CornerRadius="6" Padding="4 0 4 0"
                        Background="{StaticResource B_StatusActive}" Visibility="Collapsed">
                    <controls:SharpText Text="{Binding Duration.Current, Converter={StaticResource A_Converter_SecondsToClock}}" Style="{StaticResource T_Chip}" FontSize="11" Foreground="#1C1400" />
                </Border>
                <Border x:Name="Count" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -3 -4 0" MinWidth="14" CornerRadius="7" Padding="3 0 3 0"
                        Background="#F0101114" BorderBrush="{StaticResource B_Status}" BorderThickness="1" Visibility="Collapsed">
                    <controls:SharpText Text="{Binding TimesActivatedCount}" Style="{StaticResource T_Chip}" FontSize="11" HorizontalAlignment="Center" />
                </Border>
            </Grid>
            <controls:SharpText x:Name="Label" Text="{Binding Name}" Style="{StaticResource T_Cell}" FontSize="12" Foreground="{StaticResource B_TextMuted}"
                       HorizontalAlignment="Center" Margin="0 7 0 0" MaxWidth="64" />
        </StackPanel>
        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource A_Storyboard_CellIn}" />
            </EventTrigger>
            <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Initials" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TimesActivatedCount, Converter={StaticResource A_Converter_NumberGreater}}" Value="True">
                <Setter TargetName="Count" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Ring" Property="Content" Value="{Binding Duration}" />
                <Setter TargetName="Ring" Property="Foreground" Value="{StaticResource B_StatusActive}" />
                <Setter TargetName="Count" Property="BorderBrush" Value="{StaticResource B_StatusActive}" />
                <Setter TargetName="Timer" Property="Visibility" Value="Visible" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource B_StatusActive}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--Tenderized part: orange cell with the time left-->
    <DataTemplate DataType="{x:Type data:MonsterPartSoften}">
        <Grid x:Name="Root" Width="128" Margin="0 7 6 0" Visibility="Collapsed" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="4" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <controls:SharpText DockPanel.Dock="Right" Style="{StaticResource T_CellValue}" Foreground="{StaticResource B_Soften}" Text="{Binding Time.Current, Converter={StaticResource A_Converter_SecondsToClock}}" />
                <controls:SharpText Text="{Binding Name}" Style="{StaticResource T_Cell}" Foreground="{StaticResource B_Soften}" />
            </DockPanel>
            <controls:Gauge x:Name="Bar" Grid.Row="1" Height="6" Margin="0 3 0 0" CornerRadius="3" Fill="{StaticResource B_Soften}" Fraction="{Binding Time.Fraction}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="Hide" />
                    <BeginStoryboard x:Name="Show" Storyboard="{StaticResource A_Storyboard_Show}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="Show" />
                    <BeginStoryboard x:Name="Hide" Storyboard="{StaticResource A_Storyboard_Hide}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowBars, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--Part cell: name, break count, HP left, thin bar. Removable parts are gold.-->
    <DataTemplate DataType="{x:Type data:MonsterPart}">
        <Grid x:Name="Root" Width="128" Margin="0 7 6 0">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--Breaks after its pool is emptied N times: one pip per time-->
                    <ItemsControl x:Name="Pips" ItemsSource="{Binding BreakPips}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse x:Name="Pip" Width="7" Height="7" Margin="3 0 0 0" Stroke="{StaticResource B_Accent}" StrokeThickness="1.2" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="True">
                                        <Setter TargetName="Pip" Property="Fill" Value="{StaticResource B_Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:SharpText x:Name="Tag" Text="Broken" Style="{StaticResource T_Label}" Foreground="{StaticResource B_Accent}" Margin="5 0 0 0" Visibility="Collapsed" />
                    <controls:SharpText x:Name="Count" Style="{StaticResource T_CellValue}" Text="{Binding TimesBrokenCount, StringFormat=emptied ×{0}}" Visibility="Collapsed" />
                </StackPanel>
                <controls:SharpText x:Name="NameBlock" Text="{Binding Name}" Style="{StaticResource T_Cell}" />
            </DockPanel>
            <controls:Gauge x:Name="Bar" Grid.Row="1" Height="6" Margin="0 3 0 0" CornerRadius="3" Fill="{StaticResource B_Part}" Fraction="{Binding Health.Fraction}" />
        </Grid>
        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource A_Storyboard_CellIn}" />
            </EventTrigger>
            <DataTrigger Binding="{Binding IsRemovable}" Value="True">
                <Setter TargetName="Bar" Property="Fill" Value="{StaticResource B_Accent}" />
                <Setter TargetName="NameBlock" Property="Foreground" Value="{StaticResource B_Accent}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsThresholdUnknown}" Value="True" />
                    <Condition Binding="{Binding TimesBrokenCount, Converter={StaticResource A_Converter_NumberGreater}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Count" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <!--Broken or cut: done, so drop the bar. The game refills the pool after a break (it only drives flinches
                from then on), and a refilled bar read as "still has HP left". The tag says which, not colour alone.-->
            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                <Setter TargetName="Tag" Property="Visibility" Value="Visible" />
                <Setter TargetName="Pips" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NameBlock" Property="Foreground" Value="{StaticResource B_TextMuted}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBroken}" Value="True" />
                    <Condition Binding="{Binding IsRemovable}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Tag" Property="Text" Value="Cut" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowBars, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type data:Monster}">
        <Grid x:Name="Root" Width="462" HorizontalAlignment="Left" Margin="0 0 0 12" Visibility="Collapsed" Opacity="0" Effect="{StaticResource A_Effect_Halo}">
            <Grid.RenderTransform>
                <TranslateTransform Y="10" />
            </Grid.RenderTransform>

            <!--The monster you're fighting-->
            <Grid x:Name="Focused">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Id, Converter={StaticResource A_Converter_MonsterIcon}}" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Enraged" Style="{StaticResource A_Style_Chip}" Background="{StaticResource B_Danger}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:SharpText Text="Enraged" Style="{StaticResource T_Chip}" />
                                    <controls:SharpText Style="{StaticResource T_Chip}" FontWeight="SemiBold" Margin="5 0 0 0" Text="{Binding Rage.Duration.Current, Converter={StaticResource A_Converter_SecondsToClock}}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="Exhausted" Style="{StaticResource A_Style_Chip}" Background="#4C8DFF">
                                <StackPanel Orientation="Horizontal">
                                    <controls:SharpText Text="Tired" Style="{StaticResource T_Chip}" />
                                    <controls:SharpText Style="{StaticResource T_Chip}" FontWeight="SemiBold" Margin="5 0 0 0" Text="{Binding Fatigue.Duration.Current, Converter={StaticResource A_Converter_SecondsToClock}}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="Estimate" Style="{StaticResource A_Style_Chip}" Background="#33FFFFFF">
                                <controls:SharpText Text="Estimate" Style="{StaticResource T_Chip}" Foreground="{StaticResource B_Text}" />
                            </Border>
                        </StackPanel>
                        <controls:SharpText Text="{Binding Name}" Style="{StaticResource T_MonsterName}" />
                        <ContentControl x:Name="Crown" Width="14" Height="14" Margin="7 0 0 0" VerticalAlignment="Center" ContentTemplate="{StaticResource A_Graphic_Crown}">
                            <ContentControl.Background>
                                <SolidColorBrush Color="{StaticResource A_Color_Crown_Gold_Body}" />
                            </ContentControl.Background>
                            <ContentControl.Foreground>
                                <SolidColorBrush Color="{StaticResource A_Color_Crown_Gold_Gem}" />
                            </ContentControl.Foreground>
                        </ContentControl>
                        <controls:SharpText x:Name="Size" Style="{StaticResource T_Muted}" Margin="6 0 0 0" Text="{Binding Size, StringFormat={}{0:N0}}" />
                        <!--Weak to: element icons in circles, 3 stars bright, 2 stars dimmer-->
                        <ItemsControl ItemsSource="{Binding Weaknesses}" Margin="10 0 0 0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Element" Width="26" Height="26" Margin="0 0 4 0">
                                        <Ellipse Fill="#CC101114" Stroke="{StaticResource B_Stroke}" StrokeThickness="1" />
                                        <Image Source="{Binding Element, Converter={StaticResource A_Converter_IconKeyToImage}, ConverterParameter=Trim}" Width="16" Height="16" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Stars}" Value="2">
                                            <Setter TargetName="Element" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!--After HunterPie: health left out of the full amount, the percentage at the far end, then two thin bars-->
                    <DockPanel Margin="0 2 0 0">
                        <controls:SharpText x:Name="HealthPct" DockPanel.Dock="Right" Style="{StaticResource T_Value}" FontSize="15" VerticalAlignment="Bottom"
                                            Text="{Binding Health.Fraction, Converter={StaticResource A_Converter_FractionToPercentage}}" />
                        <!--Health left in the bright text, out of the full amount in the muted one-->
                        <StackPanel x:Name="HealthNum" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <controls:SharpText Style="{StaticResource T_Body}" Text="{Binding Health.Current, StringFormat={}{0:N0}}" />
                            <controls:SharpText Style="{StaticResource T_Muted}" Text="{Binding Health.Max, StringFormat={}/{0:N0}}" />
                        </StackPanel>
                    </DockPanel>

                    <!--Health, with a yellow triangle where the monster can be captured-->
                    <Grid x:Name="HealthBar" Height="10" Margin="0 4 0 0">
                        <controls:Gauge CornerRadius="3" Fill="{StaticResource B_MonsterHealth}" Fraction="{Binding Health.Fraction}" />
                        <!--Negative margins, not a taller box: the bar's row would clip anything taller than itself-->
                        <Grid x:Name="CaptureMark" Width="10" Margin="{Binding CaptureFraction, Converter={StaticResource A_Converter_FractionToOffset}, ConverterParameter=402}"
                              HorizontalAlignment="Left" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform X="-5" />
                            </Grid.RenderTransform>
                            <Path Data="M0,0 L10,0 L5,6 Z" Margin="0 -3 0 0" VerticalAlignment="Top" Fill="{StaticResource B_Stamina}" Stroke="#CC000000" StrokeThickness="0.75" />
                        </Grid>
                    </Grid>
                    <!--Stamina: the same bar under health, as wide, in yellow-->
                    <controls:Gauge x:Name="StaminaBar" Height="6" Margin="0 3 0 0" CornerRadius="3" Fill="{StaticResource B_Stamina}" Fraction="{Binding Stamina.Buildup.Fraction}"
                                    ToolTip="Stamina: low means the monster tires soon" />

                    <ItemsControl ItemsSource="{Binding VisibleAilments}" ItemsPanel="{StaticResource A_Panel_Wrap}" Margin="0 4 0 0" />
                    <ItemsControl ItemsSource="{Binding VisibleParts}" ItemsPanel="{StaticResource A_Panel_Wrap}" />
                    <ItemsControl ItemsSource="{Binding PartSoftens}" ItemsPanel="{StaticResource A_Panel_Wrap}" />
                </StackPanel>
            </Grid>

            <!--Any other large monster: one line-->
            <Grid x:Name="Compact" Width="320" HorizontalAlignment="Left" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Id, Converter={StaticResource A_Converter_MonsterIcon}}" Width="26" Height="26" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:SharpText Text="{Binding Name}" Style="{StaticResource T_Body}" Foreground="{StaticResource B_TextMuted}" />
                        <controls:SharpText x:Name="CompactRage" Text="Enraged" Style="{StaticResource T_Label}" Foreground="{StaticResource B_Danger}" Margin="8 0 0 0" Visibility="Collapsed" />
                    </StackPanel>
                    <controls:Gauge Height="6" Margin="0 3 0 0" CornerRadius="3" Fill="{StaticResource B_MonsterHealth}" Fraction="{Binding Health.Fraction}" />
                </StackPanel>
                <controls:SharpText Grid.Column="2" Style="{StaticResource T_Muted}" FontSize="14" Margin="10 0 0 0" VerticalAlignment="Bottom"
                           Text="{Binding Health.Fraction, Converter={StaticResource A_Converter_FractionToPercentage}}" />
            </Grid>
        </Grid>

        <DataTemplate.Triggers>
            <Trigger Property="pfComponentModel:DesignerProperties.IsInDesignMode" Value="True">
                <Setter TargetName="Root" Property="Visibility" Value="Visible" />
                <Setter TargetName="Root" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="Hide" />
                    <BeginStoryboard x:Name="Show" Storyboard="{StaticResource A_Storyboard_Show}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="Show" />
                    <BeginStoryboard x:Name="Hide" Storyboard="{StaticResource A_Storyboard_Hide}" />
                </DataTrigger.EnterActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsFocused}" Value="False">
                <Setter TargetName="Focused" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Compact" Property="Visibility" Value="Visible" />
                <Setter TargetName="Root" Property="Width" Value="320" />
                <Setter TargetName="Root" Property="Margin" Value="0 0 0 8" />
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.IsEstimate, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True" />
                    <Condition Binding="{Binding IsFocused}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Estimate" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>

            <DataTrigger Binding="{Binding IsEnraged}" Value="True">
                <Setter TargetName="Enraged" Property="Visibility" Value="Visible" />
                <Setter TargetName="CompactRage" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExhausted}" Value="True">
                <Setter TargetName="Exhausted" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasCaptureMark}" Value="True">
                <Setter TargetName="CaptureMark" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Stamina}" Value="{x:Null}">
                <Setter TargetName="StaminaBar" Property="Visibility" Value="Collapsed" />
            </DataTrigger>

            <DataTrigger Binding="{Binding DataContext.ShowCrown, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Crown" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowSize, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Size" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowBars, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="HealthBar" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="StaminaBar" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowNumbers, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="HealthNum" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowPercents, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="HealthPct" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Crown, ConverterParameter={x:Static data:MonsterCrown.None}, Converter={StaticResource A_Converter_EnumComparison}}" Value="True">
                <Setter TargetName="Crown" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Crown, ConverterParameter={x:Static data:MonsterCrown.Silver}, Converter={StaticResource A_Converter_EnumComparison}}" Value="True">
                <Setter TargetName="Crown" Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource A_Color_Crown_Silver_Body}" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Crown" Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource A_Color_Crown_Silver_Gem}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Crown, ConverterParameter={x:Static data:MonsterCrown.Mini}, Converter={StaticResource A_Converter_EnumComparison}}" Value="True">
                <Setter TargetName="Crown" Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource A_Color_Crown_Mini_Body}" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Crown" Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource A_Color_Crown_Mini_Gem}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


    <!--Team Widget: one row per hunter, drawn straight onto the game. After HunterPie's damage meter: weapon, name, the share with an arrow for where it's heading, damage and damage per second. The row fills with the
        hunter's colour as far as their damage reaches against the top hunter.-->

    <Geometry x:Key="G_Stopwatch">M6.5,0.5 L9.5,0.5 L9.5,2 L6.5,2 Z M8,3 A6,6 0 1 1 7.99,3 Z M8,4.6 A4.4,4.4 0 1 0 8.01,4.6 Z M7.3,6 L8.7,6 L8.7,9.6 L7.3,9.6 Z</Geometry>
    <GeometryGroup x:Key="G_Skull" FillRule="EvenOdd">
        <PathGeometry Figures="M8,1 C4.2,1 1.6,3.6 1.6,7 C1.6,9.1 2.6,10.6 4.2,11.5 L4.2,13.8 C4.2,14.5 4.7,15 5.4,15 L10.6,15 C11.3,15 11.8,14.5 11.8,13.8 L11.8,11.5 C13.4,10.6 14.4,9.1 14.4,7 C14.4,3.6 11.8,1 8,1 Z" />
        <EllipseGeometry Center="5.5,7.6" RadiusX="1.7" RadiusY="1.8" />
        <EllipseGeometry Center="10.5,7.6" RadiusX="1.7" RadiusY="1.8" />
        <PathGeometry Figures="M8,9.6 L9,11.4 L7,11.4 Z" />
    </GeometryGroup>
    <SolidColorBrush x:Key="B_Up" Color="#3DD68C" />

    <DataTemplate DataType="{x:Type data:Player}">
        <Grid x:Name="Root" Margin="0 2 0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--Damage against the top hunter, as a fill behind the row that fades to the right-->
            <Grid Grid.ColumnSpan="4" Margin="-6 0 0 0" behaviors:RoundClip.Radius="5">
            <Rectangle x:Name="Fill" behaviors:SmoothBar.Fraction="{Binding BarFraction}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#33000000" Offset="0" />
                        <GradientStop Color="#0A000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            </Grid>

            <!--Weapon silhouette in the hunter's colour; flashes when they land a hit-->
            <Grid Width="26" Height="26" Margin="1 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse x:Name="HitFlash" Width="26" Height="26" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Rectangle x:Name="WeaponIcon" Width="26" Height="26">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding WeaponIcon, Converter={StaticResource A_Converter_IconKeyToImage}, ConverterParameter=Trim}" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Ellipse x:Name="Dot" Width="7" Height="7" Visibility="Collapsed" />
            </Grid>

            <!--Party leader flag (read from the game, so it shows for hunters without Aether too), then the Aether badge:
                party sync heard from this teammate's Aether-->
            <StackPanel x:Name="NameRow" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 7 0 7">
                <controls:SharpText x:Name="NameBlock" Text="{Binding Name}" Style="{StaticResource T_Body}" MaxWidth="130" />
                <Path Data="M0,0 H1.5 V12 H0 Z M1.5,0.5 L10,3.5 L1.5,6.5 Z" Fill="{StaticResource B_Accent}" Width="10" Height="12" Margin="5 0 0 0" VerticalAlignment="Center"
                      ToolTip="Party leader" Visibility="{Binding IsLeader, Converter={StaticResource A_Converter_BoolToVisibility}}" />
                <Image Source="pack://application:,,,/Ui/Aether.ico" Width="12" Height="12" Margin="5 0 0 0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="Also runs Aether" Visibility="{Binding UsesAether, Converter={StaticResource A_Converter_BoolToVisibility}}" />
            </StackPanel>

            <StackPanel x:Name="Share" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 0 0">
                <!--Up and down are separate so one can fade out while the other fades in, each moving its own way-->
                <Grid Width="8" Height="6" Margin="0 0 5 0" VerticalAlignment="Center">
                    <Path x:Name="ArrowUp" Data="M0,6 L4,0 L8,6 Z" Fill="{StaticResource B_Up}" Stretch="Fill" Opacity="0">
                        <Path.RenderTransform>
                            <TranslateTransform />
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="ArrowDown" Data="M0,0 L8,0 L4,6 Z" Fill="{StaticResource B_Danger}" Stretch="Fill" Opacity="0">
                        <Path.RenderTransform>
                            <TranslateTransform />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <controls:SharpText Style="{StaticResource T_Value}" MinWidth="34" FontSize="15" Text="{Binding DamageFraction, Converter={StaticResource A_Converter_FractionToPercentage}}" />
            </StackPanel>

            <StackPanel x:Name="Numbers" Grid.Column="3" VerticalAlignment="Center" MinWidth="64" Margin="12 0 0 0">
                <controls:SharpText x:Name="DamageBlock" Style="{StaticResource T_Value}" FontSize="15" HorizontalAlignment="Right" Text="{Binding Damage, StringFormat={}{0:N0}}" />
                <controls:SharpText x:Name="DpsBlock" Style="{StaticResource T_Muted}" FontSize="11" HorizontalAlignment="Right" Text="{Binding Dps, StringFormat={}{0:N0}/s}" />
            </StackPanel>

            <!--Solo: the share is always 100%, so show what matters instead-->
            <StackPanel x:Name="Solo" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <controls:SharpText Style="{StaticResource T_Big}" Text="{Binding Damage, StringFormat={}{0:N0}}" />
                <controls:SharpText Style="{StaticResource T_Muted}" Margin="5 0 0 1" VerticalAlignment="Bottom" Text="damage" />
                <controls:SharpText x:Name="SoloDps" Style="{StaticResource T_Muted}" Margin="10 0 0 1" VerticalAlignment="Bottom" Text="{Binding Dps, StringFormat={}{0:N0}/s}" />
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding WeaponIcon}" Value="{x:Null}">
                <Setter TargetName="WeaponIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMe}" Value="True">
                <Setter TargetName="NameBlock" Property="Foreground" Value="{StaticResource B_Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Damage}" Value="0">
                <Setter TargetName="Root" Property="Opacity" Value="0.6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Dps}" Value="0">
                <Setter TargetName="DpsBlock" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SoloDps" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!--Rising: in from below, out upward. Falling: in from above, out downward.-->
            <DataTrigger Binding="{Binding Trend}" Value="1">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowUp" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="ArrowUp" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="5" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowUp" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource E_In}" />
                            <DoubleAnimation Storyboard.TargetName="ArrowUp" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.35" EasingFunction="{StaticResource E_In}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Trend}" Value="-1">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowDown" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="ArrowDown" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-5" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowDown" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource E_In}" />
                            <DoubleAnimation Storyboard.TargetName="ArrowDown" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="4" Duration="0:0:0.35" EasingFunction="{StaticResource E_In}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <!--No Aether on an expedition: no number exists for them, so don't show a misleading 0-->
            <DataTrigger Binding="{Binding IsDamageUnknown}" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                <Setter TargetName="DamageBlock" Property="Text" Value="—" />
                <Setter TargetName="Share" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Fill" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Root" Property="ToolTip" Value="Damage unknown: they need Aether with party sync on" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDamagePartial}" Value="True">
                <Setter TargetName="DamageBlock" Property="Text" Value="{Binding Damage, StringFormat=~{0:N0}}" />
                <Setter TargetName="Root" Property="ToolTip" Value="Quest targets only: they need Aether with party sync on for the rest" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowBars, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowNumbers, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Numbers" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ShowPercents, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="False">
                <Setter TargetName="Share" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsSolo, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True">
                <Setter TargetName="NameRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Share" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Numbers" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Solo" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHitting}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HitFlash" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="HitFlash" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.5" To="1.4" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="HitFlash" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="1.4" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding ., Converter={StaticResource A_Converter_PlayerToPlayerIndex}}" Value="0">
                <Setter TargetName="WeaponIcon" Property="Fill" Value="{DynamicResource B_Player0}" />
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource B_Player0}" />
                <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource B_Player0}" />
                <Setter TargetName="HitFlash" Property="Fill" Value="{DynamicResource B_Player0}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ., Converter={StaticResource A_Converter_PlayerToPlayerIndex}}" Value="1">
                <Setter TargetName="WeaponIcon" Property="Fill" Value="{DynamicResource B_Player1}" />
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource B_Player1}" />
                <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource B_Player1}" />
                <Setter TargetName="HitFlash" Property="Fill" Value="{DynamicResource B_Player1}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ., Converter={StaticResource A_Converter_PlayerToPlayerIndex}}" Value="2">
                <Setter TargetName="WeaponIcon" Property="Fill" Value="{DynamicResource B_Player2}" />
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource B_Player2}" />
                <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource B_Player2}" />
                <Setter TargetName="HitFlash" Property="Fill" Value="{DynamicResource B_Player2}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ., Converter={StaticResource A_Converter_PlayerToPlayerIndex}}" Value="3">
                <Setter TargetName="WeaponIcon" Property="Fill" Value="{DynamicResource B_Player3}" />
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource B_Player3}" />
                <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource B_Player3}" />
                <Setter TargetName="HitFlash" Property="Fill" Value="{DynamicResource B_Player3}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


    <!--Player Widget: buffs with their game icons-->

    <DataTemplate DataType="{x:Type data:PlayerStatusEffect}">
        <Grid x:Name="Root" Margin="0 2 0 2" Visibility="Collapsed" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform X="-12" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="22" Height="22" HorizontalAlignment="Left">
                <Ellipse x:Name="Danger" Width="32" Height="32" Margin="-5" Fill="{StaticResource B_DangerGlow}" Opacity="0" Visibility="Collapsed" />
                <Image x:Name="Icon" Source="{Binding IconKey, Converter={StaticResource A_Converter_IconKeyToImage}}" Width="22" Height="22" />
                <ContentControl x:Name="Ring" Content="{Binding Time}" Width="12" Height="12" ContentTemplate="{StaticResource A_DataTemplate_CircleProgress}" Foreground="{StaticResource B_Text}" Visibility="Collapsed" />
            </Grid>
            <controls:SharpText x:Name="NameBlock" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T_Body}" />
            <controls:SharpText x:Name="Remaining" Grid.Column="2" Style="{StaticResource T_Value}" Margin="14 0 0 0" Text="{Binding Time.Current, Converter={StaticResource A_Converter_SecondsToClock}}" />
        </Grid>

        <DataTemplate.Triggers>
            <Trigger Property="pfComponentModel:DesignerProperties.IsInDesignMode" Value="True">
                <Setter TargetName="Root" Property="Visibility" Value="Visible" />
                <Setter TargetName="Root" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Time}" Value="{x:Null}">
                <Setter TargetName="Remaining" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="Hide" />
                    <BeginStoryboard x:Name="Show" Storyboard="{StaticResource A_Storyboard_Player_StatusEffect_Show}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <DataTrigger.EnterActions>
                    <StopStoryboard BeginStoryboardName="Show" />
                    <BeginStoryboard x:Name="Hide" Storyboard="{StaticResource A_Storyboard_Player_StatusEffect_Hide}" />
                </DataTrigger.EnterActions>
            </DataTrigger>

            <!--About to run out: amber timer that blinks so you can refresh it-->
            <DataTrigger Binding="{Binding IsExpiring}" Value="True">
                <Setter TargetName="Remaining" Property="Foreground" Value="{StaticResource B_Warn}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Expiring">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Remaining" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Expiring" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <!--Debuffs: red name and a breathing red halo behind the icon-->
            <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                <Setter TargetName="NameBlock" Property="Foreground" Value="{StaticResource B_Danger}" />
                <Setter TargetName="Danger" Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="DebuffPulse" Storyboard="{StaticResource A_Storyboard_Danger}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="DebuffPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--Specialized tool (mantle, booster): its icon in a ring, the time beside it. Gold and draining while it's on;
        dim and filling back up while it recharges. The icon is trimmed to what's drawn, so it sits in the middle.-->
    <DataTemplate DataType="{x:Type data:SpecializedTool}">
        <StackPanel x:Name="Root" Orientation="Horizontal" Margin="0 0 18 0">
            <StackPanel.RenderTransform>
                <TranslateTransform />
            </StackPanel.RenderTransform>
            <Grid Width="32" Height="32">
                <Ellipse Margin="1" Fill="#CC101114" />
                <ContentControl x:Name="Ring" Content="{Binding Ring}" ContentTemplate="{StaticResource A_DataTemplate_ThinRing}" Foreground="{StaticResource B_Accent}" />
                <Image x:Name="Icon" Source="{Binding IconKey, Converter={StaticResource A_Converter_IconKeyToImage}, ConverterParameter=Trim}" Width="16" Height="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <controls:SharpText x:Name="Time" Text="{Binding Seconds, Converter={StaticResource A_Converter_SecondsToClock}}" Style="{StaticResource T_Value}" MinWidth="0"
                       Foreground="{StaticResource B_Accent}" Margin="7 0 0 0" />
        </StackPanel>
        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource A_Storyboard_CellIn}" />
            </EventTrigger>
            <DataTrigger Binding="{Binding IsRecharging}" Value="True">
                <Setter TargetName="Ring" Property="Foreground" Value="{StaticResource B_TextMuted}" />
                <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource B_TextMuted}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--Sharpness: the game's colour bands, hits left in the current colour-->
    <DataTemplate DataType="{x:Type data:Sharpness}">
        <StackPanel x:Name="Root" Margin="0 0 0 8">
            <DockPanel LastChildFill="False">
                <controls:SharpText x:Name="Label" Text="Sharpness" Style="{StaticResource T_Label}" />
                <controls:SharpText DockPanel.Dock="Right" Style="{StaticResource T_Value}" MinWidth="0" Text="{Binding HitsLeft}" />
                <controls:SharpText DockPanel.Dock="Right" Style="{StaticResource T_Muted}" Foreground="{Binding LevelBrush}" Margin="0 0 6 0" Text="{Binding LevelName}" />
            </DockPanel>
            <Grid x:Name="Bar" Width="150" Height="6" Margin="0 5 0 0" HorizontalAlignment="Left" behaviors:RoundClip.Radius="-1">
                <ItemsControl ItemsSource="{Binding Segments}" Opacity="0.22">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><Rectangle Width="{Binding Width}" Height="6" Fill="{Binding Brush}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas Width="{Binding FilledWidth}" HorizontalAlignment="Left" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><Rectangle Width="{Binding Width}" Height="6" Fill="{Binding Brush}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
            <controls:SharpText x:Name="Danger" Text="Sharpen" Style="{StaticResource T_Label}" Foreground="{StaticResource B_Danger}" Margin="0 4 0 0" Visibility="Collapsed" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsSharpening}" Value="True">
                <Setter TargetName="Danger" Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Sharpen" Storyboard="{StaticResource A_Storyboard_Danger}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Sharpen" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLow}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource B_Warn}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


    <!--Widget Contexts-->

    <!--Fought monster first, the rest stacked under it-->
    <DataTemplate DataType="{x:Type widgetContexts:MonsterWidgetContext}">
        <Grid x:Name="Layer" Opacity="{StaticResource A_Double_Widget_Opacity}">
            <Grid.Resources>
                <CollectionViewSource x:Key="CollectionViewSource" Source="{Binding Monsters}" IsLiveSortingRequested="True">
                    <CollectionViewSource.LiveSortingProperties>
                        <system:String>IsFocused</system:String>
                    </CollectionViewSource.LiveSortingProperties>
                    <CollectionViewSource.SortDescriptions>
                        <wbComponentModel:SortDescription PropertyName="IsFocused" Direction="Descending" />
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>
            </Grid.Resources>
            <Border x:Name="Scrim" Background="{StaticResource B_Scrim}" Opacity="{Binding ShadeOpacity, Source={x:Static viewModels:OverlayViewModel.Instance}}" OpacityMask="{StaticResource B_ScrimFeather}" Margin="-24 -12 -24 -12" />
            <StackPanel>
                <Border x:Name="Notice" Width="462" HorizontalAlignment="Left" Margin="0 0 0 10" Padding="12 8 12 8" CornerRadius="8"
                        Background="#EB101114" BorderBrush="{StaticResource B_Accent}" BorderThickness="1" Visibility="Collapsed">
                    <DockPanel>
                        <controls:SharpText Text="Sync" Style="{StaticResource T_Label}" Foreground="{StaticResource B_Accent}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0 1 10 0" />
                        <controls:SharpText Text="{Binding Notice}" Style="{StaticResource T_Body}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="MonstersControl" ItemsSource="{Binding Source={StaticResource CollectionViewSource}}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger Property="pfComponentModel:DesignerProperties.IsInDesignMode" Value="True">
                <Setter TargetName="MonstersControl" Property="ItemsSource" Value="{Binding Monsters}" />
            </Trigger>
            <DataTrigger Binding="{Binding Notice, Converter={StaticResource A_Converter_IsNotNull}}" Value="True">
                <Setter TargetName="Notice" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!--Nothing to show: no shade either-->
            <DataTrigger Binding="{Binding HasVisibleMonsters}" Value="False">
                <Setter TargetName="Scrim" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Widget.IsRightAligned, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                <Setter TargetName="Scrim" Property="Background" Value="{StaticResource B_ScrimRight}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="A_Style_ItemsControl_PlayerStatusEffects" TargetType="{x:Type ItemsControl}">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel ClipToBounds="False" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type widgetContexts:PlayerWidgetContext}">
        <Border Style="{StaticResource A_Style_Scrim}" Opacity="{StaticResource A_Double_Widget_Opacity}">
            <Border.Resources>
                <CollectionViewSource x:Key="CollectionViewSource" Source="{Binding StatusEffects}" IsLiveSortingRequested="True">
                    <CollectionViewSource.LiveSortingProperties>
                        <system:String>SortGroup</system:String>
                        <system:String>Time.Current</system:String>
                    </CollectionViewSource.LiveSortingProperties>
                    <CollectionViewSource.SortDescriptions>
                        <wbComponentModel:SortDescription PropertyName="SortGroup" Direction="Ascending" />
                        <wbComponentModel:SortDescription PropertyName="Time.Current" Direction="Ascending" />
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>
            </Border.Resources>
            <Grid x:Name="Layer">
            <Border x:Name="Scrim" Background="{StaticResource B_Scrim}" Opacity="{Binding ShadeOpacity, Source={x:Static viewModels:OverlayViewModel.Instance}}" OpacityMask="{StaticResource B_ScrimFeather}" />
            <StackPanel x:Name="Body" Effect="{StaticResource A_Effect_Halo}" MinWidth="200" Margin="18 14 44 14">
                <!--Quest clock, the Team widget's: shown here only while that one isn't on screen (hidden, or solo)-->
                <StackPanel x:Name="HuntLine" Orientation="Horizontal" Margin="0 0 0 8">
                    <Path Data="{StaticResource G_Stopwatch}" Fill="{StaticResource B_TextMuted}" Width="14" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0 0 6 0" />
                    <controls:SharpText Text="{Binding Hunt.Clock}" Style="{StaticResource T_Value}" MinWidth="0" />
                    <controls:SharpText Text="{Binding Hunt.ClockLimit, StringFormat=/{0}, TargetNullValue=''}" Style="{StaticResource T_Muted}" VerticalAlignment="Bottom" Margin="2 0 0 0" />
                </StackPanel>
                <ContentControl Content="{Binding Sharpness}" />
                <ItemsControl x:Name="Tools" ItemsSource="{Binding Tools}" Margin="0 0 0 8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="StatusEffectsControl" ItemsSource="{Binding Source={StaticResource CollectionViewSource}}" Style="{StaticResource A_Style_ItemsControl_PlayerStatusEffects}" />
            </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger Property="pfComponentModel:DesignerProperties.IsInDesignMode" Value="True">
                <Setter TargetName="StatusEffectsControl" Property="ItemsSource" Value="{Binding StatusEffects}" />
            </Trigger>
            <DataTrigger Binding="{Binding Hunt.Clock}" Value="{x:Null}">
                <Setter TargetName="HuntLine" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding TeamWidget.IsVisible, Source={x:Static viewModels:OverlayViewModel.Instance}}" Value="True" />
                    <Condition Binding="{Binding TeamWidget.Context.Fake_Players.Count, Source={x:Static viewModels:OverlayViewModel.Instance}, Converter={StaticResource A_Converter_NumberGreater}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HuntLine" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Tools.Count}" Value="0">
                <Setter TargetName="Tools" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!--Placed on the right half of the screen: mirror the fade-->
            <DataTrigger Binding="{Binding Widget.IsRightAligned, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                <Setter TargetName="Scrim" Property="Background" Value="{StaticResource B_ScrimRight}" />
                <Setter TargetName="Body" Property="Margin" Value="44 14 18 14" />
            </DataTrigger>

        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="A_Style_ItemsControl_Players" TargetType="{x:Type ItemsControl}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type widgetContexts:TeamWidgetContext}">
        <Border x:Name="Card" Style="{StaticResource A_Style_Scrim}" Opacity="{StaticResource A_Double_Widget_Opacity}">
            <Border.Resources>
                <CollectionViewSource x:Key="CollectionViewSource" Source="{Binding Fake_Players}" IsLiveSortingRequested="True">
                    <CollectionViewSource.LiveSortingProperties>
                        <system:String>Damage</system:String>
                    </CollectionViewSource.LiveSortingProperties>
                    <CollectionViewSource.SortDescriptions>
                        <wbComponentModel:SortDescription PropertyName="Damage" Direction="Descending" />
                        <wbComponentModel:SortDescription PropertyName="Index" Direction="Ascending" />
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>
            </Border.Resources>

            <Grid x:Name="Layer">
            <Border x:Name="Scrim" Background="{StaticResource B_Scrim}" Opacity="{Binding ShadeOpacity, Source={x:Static viewModels:OverlayViewModel.Instance}}" OpacityMask="{StaticResource B_ScrimFeather}" />
            <StackPanel x:Name="Body" Effect="{StaticResource A_Effect_Halo}" Margin="18 14 44 14">
                <!--Quest clock and party deaths; outside a quest just the title-->
                <DockPanel LastChildFill="False" DataContext="{Binding PlayerWidget.Context.Hunt, Source={x:Static viewModels:OverlayViewModel.Instance}}">
                    <controls:SharpText x:Name="Title" Text="Damage" Style="{StaticResource T_Label}" />
                    <StackPanel x:Name="Clock" Orientation="Horizontal" Visibility="Collapsed">
                        <Path Data="{StaticResource G_Stopwatch}" Fill="{StaticResource B_TextMuted}" Width="14" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0 0 6 0" />
                        <controls:SharpText Text="{Binding Clock}" Style="{StaticResource T_Value}" MinWidth="0" />
                        <controls:SharpText Text="{Binding ClockLimit, StringFormat=/{0}, TargetNullValue=''}" Style="{StaticResource T_Muted}" VerticalAlignment="Bottom" Margin="2 0 0 0" />
                    </StackPanel>
                    <StackPanel x:Name="Deaths" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                        <Path Data="{StaticResource G_Skull}" Fill="{StaticResource B_TextMuted}" Width="14" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0 0 6 0" />
                        <controls:SharpText Text="{Binding Deaths}" Style="{StaticResource T_Value}" MinWidth="0" />
                    </StackPanel>
                </DockPanel>
                <Rectangle Height="1" Margin="0 6 0 4" Fill="{StaticResource B_Hairline}" />

                <oxy:Plot Background="Transparent" TextColor="Transparent" PlotAreaBorderColor="Transparent" PlotMargins="0" Height="70" Margin="0 2 0 4"
                          Visibility="{Binding ShowChart, Converter={StaticResource A_Converter_BoolToVisibility}}">
                    <oxy:Plot.Axes>
                        <oxy:LinearAxis Position="Left" TickStyle="None" />
                        <oxy:LinearAxis Position="Bottom" TickStyle="None" />
                    </oxy:Plot.Axes>
                    <oxy:Plot.Series>
                        <oxy:AreaSeries Color="{StaticResource A_Color_Player_0}" />
                        <oxy:AreaSeries Color="{StaticResource A_Color_Player_1}" />
                        <oxy:AreaSeries Color="{StaticResource A_Color_Player_2}" />
                        <oxy:AreaSeries Color="{StaticResource A_Color_Player_3}" />
                    </oxy:Plot.Series>
                    <b:Interaction.Behaviors>
                        <behaviors:UpdateOxyPlotBehavior TickInterval="200" />
                    </b:Interaction.Behaviors>
                </oxy:Plot>

                <ItemsControl x:Name="PlayersControl" ItemsSource="{Binding Source={StaticResource CollectionViewSource}}" Style="{StaticResource A_Style_ItemsControl_Players}" />
            </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger Property="pfComponentModel:DesignerProperties.IsInDesignMode" Value="True">
                <Setter TargetName="PlayersControl" Property="ItemsSource" Value="{Binding Fake_Players}" />
            </Trigger>
            <!--Placed on the right half of the screen: mirror the fade-->
            <DataTrigger Binding="{Binding Widget.IsRightAligned, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                <Setter TargetName="Scrim" Property="Background" Value="{StaticResource B_ScrimRight}" />
                <Setter TargetName="Body" Property="Margin" Value="44 14 18 14" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Fake_Players.Count}" Value="0">
                <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PlayerWidget.Context.Hunt.Clock, Source={x:Static viewModels:OverlayViewModel.Instance}, Converter={StaticResource A_Converter_IsNotNull}}" Value="True">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Clock" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PlayerWidget.Context.Hunt.Deaths, Source={x:Static viewModels:OverlayViewModel.Instance}, Converter={StaticResource A_Converter_IsNotNull}}" Value="True">
                <Setter TargetName="Deaths" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--Call-outs: floating monster name with state tags, centred near the top of the screen-->

    <RadialGradientBrush x:Key="B_CalloutScrim" RadiusX="0.55" RadiusY="0.7">
        <GradientStop Color="#8C000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <Style x:Key="A_Style_Tag" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7 2 7 2" />
        <Setter Property="Margin" Value="8 0 0 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="T_Tag" TargetType="{x:Type controls:SharpText}" BasedOn="{StaticResource A_Style_TextBlock_Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <DataTemplate DataType="{x:Type widgetContexts:MonsterCallout}">
        <Grid x:Name="Root" Margin="6 0 6 0" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-8" />
            </Grid.RenderTransform>
            <Border Background="{StaticResource B_CalloutScrim}" Margin="-24 -12 -24 -12" />
            <StackPanel Orientation="Horizontal" Margin="12 6 12 6" Effect="{StaticResource A_Effect_Halo}">
                <controls:SharpText Text="{Binding Name}" Style="{StaticResource T_Body}" FontSize="15" FontWeight="Bold" />
                <Border x:Name="Capture" Style="{StaticResource A_Style_Tag}" Background="{StaticResource B_Accent}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                    <controls:SharpText Text="Capture" Style="{StaticResource T_Tag}" Foreground="#1C1400" />
                </Border>
                <Border x:Name="Enraged" Style="{StaticResource A_Style_Tag}" Background="{StaticResource B_Danger}">
                    <controls:SharpText Text="Enraged" Style="{StaticResource T_Tag}" Foreground="White" />
                </Border>
                <Border x:Name="Exhausted" Style="{StaticResource A_Style_Tag}" Background="#4C8DFF">
                    <controls:SharpText Text="Exhausted" Style="{StaticResource T_Tag}" Foreground="White" />
                </Border>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource E_Out}" />
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <DataTrigger Binding="{Binding IsCapturable}" Value="True">
                <Setter TargetName="Capture" Property="Visibility" Value="Visible" />
                <!--Three gentle pops so you notice, then it stays put-->
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Capture" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.18" Duration="0:0:0.22" AutoReverse="True" RepeatBehavior="3x" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Capture" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.18" Duration="0:0:0.22" AutoReverse="True" RepeatBehavior="3x" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnraged}" Value="True">
                <Setter TargetName="Enraged" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExhausted}" Value="True">
                <Setter TargetName="Exhausted" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgetContexts:CalloutWidgetContext}">
        <ItemsControl ItemsSource="{Binding Callouts}" MinWidth="300" MinHeight="30" Opacity="{StaticResource A_Double_Widget_Opacity}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>


    <!--Hunt recap: the quest-end card, in the widgets' language: a dark card with a hairline border, the Team widget's
        clock and skull, monster portraits, and party rows with gauges-->

    <SolidColorBrush x:Key="B_RecapCard" Color="#F2121417" />
    <SolidColorBrush x:Key="B_RecapTile" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="B_RecapDivider" Color="#17FFFFFF" />
    <Geometry x:Key="G_Check">M3,8.5 L6.5,12 L13,4.5</Geometry>
    <Geometry x:Key="G_Star">M8,0.6 L10.2,5.3 L15.3,5.9 L11.5,9.4 L12.6,14.5 L8,11.9 L3.4,14.5 L4.5,9.4 L0.7,5.9 L5.8,5.3 Z</Geometry>
    <Geometry x:Key="G_Cross">M4,4 L12,12 M12,4 L4,12</Geometry>
    <!--Captured: a padlock-->
    <Geometry x:Key="G_Lock">M5.5,7.5 L5.5,5.5 A2.5,2.5 0 0 1 10.5,5.5 L10.5,7.5 M4,7.5 L12,7.5 L12,13.5 L4,13.5 Z</Geometry>

    <!--One hunter: rank, weapon, name (crown for the top hunter) and damage; the bar under it with the share beside it.
        Rows slide in one after another and their bars fill in turn.-->
    <DataTemplate DataType="{x:Type widgetContexts:RecapHunter}">
        <Grid x:Name="Row" Margin="0 6 0 6" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform X="-14" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:SharpText Grid.RowSpan="2" Text="{Binding Rank}" Style="{StaticResource T_Muted}" />
            <Rectangle x:Name="Icon" Grid.Column="1" Grid.RowSpan="2" Width="26" Height="26" HorizontalAlignment="Left">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{Binding WeaponIcon, Converter={StaticResource A_Converter_IconKeyToImage}, ConverterParameter=Trim}" Stretch="Uniform" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <controls:SharpText x:Name="NameBlock" Text="{Binding Name}" Style="{StaticResource T_Body}" MaxWidth="190" />
                <ContentControl x:Name="Crown" Width="14" Height="14" Margin="6 0 0 1" ContentTemplate="{StaticResource A_Graphic_Crown}" Visibility="Collapsed" VerticalAlignment="Center">
                    <ContentControl.Background>
                        <SolidColorBrush Color="{StaticResource A_Color_Crown_Gold_Body}" />
                    </ContentControl.Background>
                    <ContentControl.Foreground>
                        <SolidColorBrush Color="{StaticResource A_Color_Crown_Gold_Gem}" />
                    </ContentControl.Foreground>
                </ContentControl>
            </StackPanel>
            <controls:SharpText Grid.Column="3" Style="{StaticResource T_Value}" MinWidth="44" Margin="12 0 0 0" Text="{Binding Damage, StringFormat={}{0:N0}}" />
            <controls:Gauge x:Name="Bar" Grid.Row="1" Grid.Column="2" Height="9" Margin="0 6 0 0" CornerRadius="4" ShowMarkers="False" IsSmooth="True" />
            <controls:SharpText Grid.Row="1" Grid.Column="3" Style="{StaticResource T_Muted}" FontSize="12" MinWidth="44" TextAlignment="Right" Margin="12 6 0 0"
                                VerticalAlignment="Center" Text="{Binding Share, Converter={StaticResource A_Converter_FractionToPercentage}}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMe}" Value="True">
                <Setter TargetName="NameBlock" Property="Foreground" Value="{StaticResource B_Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMvp}" Value="True">
                <Setter TargetName="Crown" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorIndex}" Value="0">
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource B_Player0}" />
                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource B_Player0}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorIndex}" Value="1">
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource B_Player1}" />
                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource B_Player1}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorIndex}" Value="2">
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource B_Player2}" />
                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource B_Player2}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorIndex}" Value="3">
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource B_Player3}" />
                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource B_Player3}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.IsShowing, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True" />
                    <Condition Binding="{Binding Rank}" Value="1" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bar" Property="Delay" Value="380" />
                <Setter TargetName="Bar" Property="Fraction" Value="{Binding Bar}" />
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.300" Duration="0:0:0.32" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-14" To="0" BeginTime="0:0:0.300" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.IsShowing, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True" />
                    <Condition Binding="{Binding Rank}" Value="2" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bar" Property="Delay" Value="450" />
                <Setter TargetName="Bar" Property="Fraction" Value="{Binding Bar}" />
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.370" Duration="0:0:0.32" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-14" To="0" BeginTime="0:0:0.370" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.IsShowing, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True" />
                    <Condition Binding="{Binding Rank}" Value="3" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bar" Property="Delay" Value="520" />
                <Setter TargetName="Bar" Property="Fraction" Value="{Binding Bar}" />
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.440" Duration="0:0:0.32" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-14" To="0" BeginTime="0:0:0.440" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.IsShowing, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True" />
                    <Condition Binding="{Binding Rank}" Value="4" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bar" Property="Delay" Value="590" />
                <Setter TargetName="Bar" Property="Fraction" Value="{Binding Bar}" />
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.510" Duration="0:0:0.32" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-14" To="0" BeginTime="0:0:0.510" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--One monster: portrait with a badge for how it went down (a red cross when slain, the usual end; a gold padlock
        when captured), its name and the outcome-->
    <DataTemplate DataType="{x:Type widgetContexts:RecapMonster}">
        <Border x:Name="Card" CornerRadius="8" Background="{StaticResource B_RecapTile}" BorderBrush="{StaticResource B_GaugeBorder}" BorderThickness="1"
                Padding="5 5 12 5" Margin="0 0 8 8" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="8" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Grid Width="32" Height="32">
                    <Image Source="{Binding Id, Converter={StaticResource A_Converter_MonsterIcon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!--Even sizes: an odd gap put the glyph on a half pixel, and layout rounding pushed it off centre-->
                    <Grid x:Name="Badge" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 -6 -5" Visibility="Collapsed">
                        <Ellipse x:Name="BadgeBack" Fill="#F2D42C2C" Stroke="#FF121417" StrokeThickness="2" />
                        <Path x:Name="BadgeGlyph" Data="{StaticResource G_Cross}" Stroke="White" StrokeThickness="1.8" Width="8" Height="8" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Grid>
                </Grid>
                <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                    <controls:SharpText Text="{Binding Name}" Style="{StaticResource T_Body}" />
                    <controls:SharpText x:Name="Outcome" Text="{Binding Outcome}" Style="{StaticResource T_Muted}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSlain}" Value="True">
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCaptured}" Value="True">
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                <Setter TargetName="BadgeBack" Property="Fill" Value="{StaticResource B_Accent}" />
                <Setter TargetName="BadgeGlyph" Property="Data" Value="{StaticResource G_Lock}" />
                <Setter TargetName="BadgeGlyph" Property="Stroke" Value="#1C1400" />
                <Setter TargetName="BadgeGlyph" Property="StrokeThickness" Value="1.5" />
                <Setter TargetName="BadgeGlyph" Property="Width" Value="8" />
                <Setter TargetName="BadgeGlyph" Property="Height" Value="10" />
                <Setter TargetName="Outcome" Property="Foreground" Value="{StaticResource B_Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsShowing, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" BeginTime="0:0:0.2" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="A_Style_RecapTile" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource B_RecapTile}" />
        <Setter Property="BorderBrush" Value="{StaticResource B_GaugeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14 10 14 12" />
    </Style>
    <BackEase x:Key="E_Settle" EasingMode="EaseOut" Amplitude="0.35" />
    <BackEase x:Key="E_Pop" EasingMode="EaseOut" Amplitude="0.7" />

    <!--The card rises into place with a slight overshoot, the badge pops, the heading and then the rest follow. Shown once
        a quest, so it animates at the monitor's refresh rate instead of the overlay's 30 fps.-->
    <DataTemplate DataType="{x:Type widgetContexts:RecapWidgetContext}">
        <Grid x:Name="Root" Width="460" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.6">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    <TranslateTransform Y="18" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border Background="{StaticResource B_RecapCard}" BorderBrush="{StaticResource B_GaugeBorder}" BorderThickness="1" CornerRadius="12" />

            <StackPanel Margin="22 18 22 18" DataContext="{Binding Recap}">
                <!--Result, with the quest time and deaths under it, stars on the right-->
                <DockPanel>
                    <Grid x:Name="ResultBadge" DockPanel.Dock="Left" Width="34" Height="34" Margin="0 0 12 0" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="BadgeBack" Fill="#263DD68C" />
                        <Path x:Name="BadgeGlyph" Data="{StaticResource G_Check}" Stroke="{StaticResource B_Up}" StrokeThickness="2.2" Width="15" Height="15" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Grid>
                    <!--Quest stars, drawn (one per character of Stars), centred on the header-->
                    <ItemsControl x:Name="Stars" DockPanel.Dock="Right" ItemsSource="{Binding Stars}" VerticalAlignment="Center" Margin="12 0 0 0" Opacity="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{StaticResource G_Star}" Fill="{StaticResource B_Accent}" Width="14" Height="14" Stretch="Uniform" Margin="1 0 1 0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="Heading" VerticalAlignment="Center" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="-10" />
                        </StackPanel.RenderTransform>
                        <controls:SharpText x:Name="Result" Text="{Binding Result}" Style="{StaticResource T_Big}" />
                        <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                            <Path Data="{StaticResource G_Stopwatch}" Fill="{StaticResource B_TextMuted}" Width="12" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0 0 5 0" />
                            <controls:SharpText Text="{Binding Time}" Style="{StaticResource T_Muted}" />
                            <Path Data="{StaticResource G_Skull}" Fill="{StaticResource B_TextMuted}" Width="12" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="14 0 5 0" />
                            <controls:SharpText Text="{Binding DeathsText}" Style="{StaticResource T_Muted}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Rectangle x:Name="MonstersLine" Height="1" Margin="0 16 0 14" Fill="{StaticResource B_RecapDivider}" />
                <ItemsControl x:Name="Monsters" ItemsSource="{Binding Monsters}" Margin="0 0 0 -8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Rectangle Height="1" Margin="0 14 0 10" Fill="{StaticResource B_RecapDivider}" />

                <!--Versus the party-->
                <StackPanel x:Name="Party">
                    <DockPanel x:Name="PartyHeader" LastChildFill="False" Margin="0 0 0 2" Opacity="0">
                        <controls:SharpText Text="Party damage" Style="{StaticResource T_Label}" />
                        <controls:SharpText DockPanel.Dock="Right" Text="{Binding Headline}" Style="{StaticResource T_Muted}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Hunters}" />
                </StackPanel>

                <!--Solo: your damage and damage per second-->
                <UniformGrid x:Name="Solo" Columns="2" Visibility="Collapsed" Opacity="0">
                    <UniformGrid.RenderTransform>
                        <TranslateTransform Y="8" />
                    </UniformGrid.RenderTransform>
                    <Border Style="{StaticResource A_Style_RecapTile}" Margin="0 0 5 0">
                        <StackPanel>
                            <controls:SharpText Text="Damage" Style="{StaticResource T_Label}" FontSize="12" />
                            <controls:SharpText Text="{Binding MyDamage, StringFormat={}{0:N0}}" Style="{StaticResource T_Big}" Margin="0 3 0 0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource A_Style_RecapTile}" Margin="5 0 0 0">
                        <StackPanel>
                            <controls:SharpText Text="Per second" Style="{StaticResource T_Label}" FontSize="12" />
                            <controls:SharpText Text="{Binding MyDps, StringFormat={}{0:N0}}" Style="{StaticResource T_Big}" Margin="0 3 0 0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Recap.IsSuccess}" Value="False">
                <Setter TargetName="BadgeBack" Property="Fill" Value="#26FF4D5A" />
                <Setter TargetName="BadgeGlyph" Property="Data" Value="{StaticResource G_Cross}" />
                <Setter TargetName="BadgeGlyph" Property="Stroke" Value="{StaticResource B_Danger}" />
                <Setter TargetName="BadgeGlyph" Property="Width" Value="12" />
                <Setter TargetName="BadgeGlyph" Property="Height" Value="12" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Recap.IsSolo}" Value="True">
                <Setter TargetName="Party" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Solo" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Recap.Monsters.Count}" Value="0">
                <Setter TargetName="Monsters" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MonstersLine" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsShowing}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.94" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource E_Settle}" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.94" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource E_Settle}" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="18" To="0" Duration="0:0:0.55" EasingFunction="{StaticResource E_Settle}" />

                            <DoubleAnimation Storyboard.TargetName="ResultBadge" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="ResultBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.5" To="1" BeginTime="0:0:0.1" Duration="0:0:0.45" EasingFunction="{StaticResource E_Pop}" />
                            <DoubleAnimation Storyboard.TargetName="ResultBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="1" BeginTime="0:0:0.1" Duration="0:0:0.45" EasingFunction="{StaticResource E_Pop}" />
                            <DoubleAnimation Storyboard.TargetName="Heading" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.14" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Heading" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-10" To="0" BeginTime="0:0:0.14" Duration="0:0:0.4" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Stars" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.35" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="PartyHeader" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.26" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Solo" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.26" Duration="0:0:0.3" EasingFunction="{StaticResource E_Out}" />
                            <DoubleAnimation Storyboard.TargetName="Solo" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" BeginTime="0:0:0.26" Duration="0:0:0.45" EasingFunction="{StaticResource E_Out}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource E_In}" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.26" EasingFunction="{StaticResource E_In}" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.26" EasingFunction="{StaticResource E_In}" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="12" Duration="0:0:0.26" EasingFunction="{StaticResource E_In}" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.26" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgetContexts:DebugWidgetContext}">
        <Border Style="{StaticResource A_Style_Card}" Margin="0 23 0 0" Opacity="{StaticResource A_Double_Widget_Opacity}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="controls:SharpText" BasedOn="{StaticResource A_Style_TextBlock_Standard}">
                        <Setter Property="Margin" Value="0 2 0 2" />
                    </Style>
                </Grid.Resources>

                <controls:SharpText Grid.Row="0" Style="{StaticResource T_Muted}" Margin="0 2 16 2" Text="Player" />
                <controls:SharpText Grid.Row="1" Style="{StaticResource T_Muted}" Margin="0 2 16 2" Text="Session" />
                <controls:SharpText Grid.Row="2" Style="{StaticResource T_Muted}" Margin="0 2 16 2" Text="Session host" />
                <controls:SharpText Grid.Row="3" Style="{StaticResource T_Muted}" Margin="0 2 16 2" Text="Lobby" />
                <controls:SharpText Grid.Row="4" Style="{StaticResource T_Muted}" Margin="0 2 16 2" Text="Lobby host" />
                <controls:SharpText Grid.Row="5" Style="{StaticResource T_Muted}" Margin="0 2 16 2" Text="Weapon" />

                <controls:SharpText Grid.Row="0" Grid.Column="1" Text="{Binding CurrentGame.CurrentPlayerName}" />
                <controls:SharpText Grid.Row="1" Grid.Column="1" Text="{Binding CurrentGame.SessionID}" />
                <controls:SharpText Grid.Row="2" Grid.Column="1" Text="{Binding CurrentGame.SessionHostPlayerName}" />
                <controls:SharpText Grid.Row="3" Grid.Column="1" Text="{Binding CurrentGame.LobbyID}" />
                <controls:SharpText Grid.Row="4" Grid.Column="1" Text="{Binding CurrentGame.LobbyHostPlayerName}" />
                <controls:SharpText Grid.Row="5" Grid.Column="1" Text="{Binding CurrentGame.EquippedWeaponType, Converter={StaticResource A_Converter_WeaponTypeToName}}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
