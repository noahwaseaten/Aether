<Window x:Class="SmartHunter.Ui.Windows.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:SmartHunter.Core"
        xmlns:viewModels="clr-namespace:SmartHunter.Game.Data.ViewModels"
        xmlns:controls="clr-namespace:SmartHunter.Ui.Controls"
        d:DataContext="{x:Static viewModels:ConsoleViewModel.Instance}"
        mc:Ignorable="d"
        Icon="/Ui/Aether.ico"
        Title="Aether" Height="700" Width="560" MinWidth="460" MinHeight="420"
        Background="#111214" Foreground="#F3EDE0" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="#D8D0BE" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Surface" Color="#1A1B1E" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#212226" />
        <SolidColorBrush x:Key="Stroke" Color="#2A2722" />
        <SolidColorBrush x:Key="Muted" Color="#A39C8C" />
        <SolidColorBrush x:Key="Accent" Color="#E2C27A" />
        <CubicEase x:Key="Ease" EasingMode="EaseOut" />

        <!--Thin scrollbar-->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#3A3B42" Margin="2 0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Segmented tabs-->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill" CornerRadius="7" Padding="14 6" Margin="0 0 4 0" Background="Transparent" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2A2B30" />
                                <Setter Property="Foreground" Value="#F3EDE0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="#D8D0BE" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Margin="20 0 20 12" Padding="3" CornerRadius="9" Background="{StaticResource Surface}" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Animated switch-->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="#34353B" />
                            <Border x:Name="TrackOn" CornerRadius="11" Background="{StaticResource Accent}" Opacity="0" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3 0 0 0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.18" EasingFunction="{StaticResource Ease}" />
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource Ease}" />
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F3EDE0" />
            <Setter Property="Background" Value="#2A2B30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="7" Padding="12 5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel x:Name="Shell">
        <!--Title bar: same surface as the window, drag anywhere on it-->
        <DockPanel DockPanel.Dock="Top" Height="40">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
            <Rectangle Width="16" Height="16" Margin="14 0 10 0" Fill="{StaticResource Accent}" VerticalAlignment="Center">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{StaticResource ICON_GREATSWORD}" Stretch="Uniform" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock x:Name="TitleText" Text="Aether" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" />
        </DockPanel>

        <!--Header-->
        <StackPanel DockPanel.Dock="Top" Margin="22 6 22 14">
            <TextBlock Text="Aether" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Monster Hunter: World overlay. Settings apply instantly." Foreground="{StaticResource Muted}" Margin="0 3 0 0" TextWrapping="Wrap" />

            <!--Layout editing: the button and holding Left Alt in game do the same thing-->
            <Border Margin="0 14 0 0" Padding="14 12" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    DataContext="{x:Static viewModels:OverlayViewModel.Instance}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 0 0">
                        <Button Content="Reset layout" Click="ResetLayout_Click" Style="{StaticResource PillButton}" Margin="0 0 8 0"
                                ToolTip="Put every widget back in its default spot and size" />
                        <ToggleButton x:Name="EditButton" IsChecked="{Binding CanManipulateWindows, Mode=TwoWay}" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="B" CornerRadius="7" Padding="12 5" Background="{StaticResource Accent}">
                                        <TextBlock x:Name="T" Text="Edit layout" FontWeight="SemiBold" Foreground="#1C1400" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="T" Property="Text" Value="Done" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EditTitle" Text="Widget layout" FontWeight="SemiBold" />
                        <TextBlock x:Name="EditHint" FontSize="12" TextWrapping="Wrap" Margin="0 2 0 0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter Property="Text" Value="Click Edit layout, or hold Left Alt in game." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanManipulateWindows}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter Property="Text" Value="Drag to move. Scroll to resize, Ctrl+scroll for small steps. Double-click resets the size. Hold Shift to turn off snapping." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl>
            <TabItem Header="Settings" x:Name="SettingsTab">
                <DockPanel>
                    <!--Only shows for the few options that need a restart-->
                    <Border DockPanel.Dock="Top" Margin="20 0 20 10" Padding="14 10" CornerRadius="10" Background="#26E2C27A" BorderBrush="#66E2C27A" BorderThickness="1"
                            Visibility="{Binding NeedsRestart, Converter={StaticResource A_Converter_BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Restart now" Command="{Binding RestartCommand}" Style="{StaticResource PillButton}" Background="{StaticResource Accent}" Foreground="#1C1400" />
                            <TextBlock Text="{Binding RestartReason}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20 0 14 20">
                        <ItemsControl ItemsSource="{Binding Settings}" Margin="0 0 6 0">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="11.5" FontWeight="Bold" Margin="4 16 0 8" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:Setting}">
                                    <Border x:Name="Row" Margin="0 0 0 4" Padding="14 10" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                        <DockPanel>
                                            <CheckBox x:Name="Switch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16 0 0 0" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding Value, Mode=TwoWay}" Command="{Binding TriggerAction}" />
                                            <Button x:Name="Action" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16 0 0 0" Visibility="Collapsed"
                                                    Content="{Binding ActionLabel}" Command="{Binding TriggerAction}" Style="{StaticResource PillButton}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Border x:Name="RestartChip" Margin="8 0 0 0" Padding="6 1" CornerRadius="4" Background="#2A2B30" Visibility="Collapsed" VerticalAlignment="Center">
                                                        <TextBlock Text="Restart" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="Description" Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0 2 0 0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsToggle}" Value="False">
                                            <Setter TargetName="Switch" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Action" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                            <Setter TargetName="RestartChip" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Log" x:Name="LogsTab">
                <Border Margin="20 0 20 20" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="4">
                    <controls:ScrollingTextBox Text="{Binding Output}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                               Background="Transparent" Foreground="#D8D0BE" BorderThickness="0" Padding="8"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
