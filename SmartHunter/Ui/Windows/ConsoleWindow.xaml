<Window x:Class="SmartHunter.Ui.Windows.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:SmartHunter.Core"
        xmlns:viewModels="clr-namespace:SmartHunter.Game.Data.ViewModels"
        xmlns:controls="clr-namespace:SmartHunter.Ui.Controls"
        xmlns:behaviors="clr-namespace:SmartHunter.Ui.Behaviors"
        xmlns:helpers="clr-namespace:SmartHunter.Core.Helpers"
        xmlns:converters="clr-namespace:SmartHunter.Ui.Converters"
        d:DataContext="{x:Static viewModels:ConsoleViewModel.Instance}"
        mc:Ignorable="d"
        Icon="/Ui/Aether.ico"
        Title="Aether" Height="640" Width="880" MinWidth="680" MinHeight="480"
        Background="#111214" Foreground="#F3EDE0" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:AnyShownConverter x:Key="AnyShown" />
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="#D8D0BE" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Surface" Color="#1A1B1E" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#212226" />
        <SolidColorBrush x:Key="Stroke" Color="#2A2722" />
        <SolidColorBrush x:Key="Muted" Color="#B0AA9A" />
        <SolidColorBrush x:Key="Accent" Color="#E2C27A" />
        <CubicEase x:Key="Ease" EasingMode="EaseOut" />

        <!--Every scroll area in the window, the Log's text box included, glides instead of jumping-->
        <Style TargetType="ScrollViewer">
            <Setter Property="behaviors:SmoothScroll.IsEnabled" Value="True" />
        </Style>

        <!--Thin scrollbar-->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#3A3B42" Margin="2 0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Segmented tabs-->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill" CornerRadius="7" Padding="14 6" Margin="0 0 4 0" Background="Transparent" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2A2B30" />
                                <Setter Property="Foreground" Value="#F3EDE0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="#D8D0BE" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Margin="20 0 20 8" Padding="3" CornerRadius="9" Background="{StaticResource Surface}" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Animated switch-->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="behaviors:SwitchAnimation.IsEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="#34353B" />
                            <Border x:Name="TrackOn" CornerRadius="11" Background="{StaticResource Accent}" Opacity="0" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3 0 0 0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0 0 3 0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--Quiet text button: the secondary action under a primary one-->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="4 6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F3EDE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F3EDE0" />
            <Setter Property="Background" Value="#2A2B30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="7" Padding="12 5" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Setting explanations: fade in and rise a few pixels-->
        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Padding="0 0 12 14">
                            <Border x:Name="B" MaxWidth="320" Padding="12 9" CornerRadius="8" Background="#26272C" BorderBrush="#3A3B42" BorderThickness="1" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="4" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
                                </Border.Effect>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap"
                                           Foreground="#E8E2D4" FontSize="12" LineHeight="17" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="{x:Static helpers:WindowHelper.PrimaryRefreshRate}">
                                            <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource Ease}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="#34353B" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type core:SettingsCategory}">
                                <Button Command="{Binding Select}" Margin="0 0 0 2" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" CornerRadius="8" Padding="12 7 8 7" Background="Transparent">
                                                <Grid>
                                                    <Rectangle x:Name="Bar" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="-9 0 0 0" Visibility="Collapsed" />
                                                    <DockPanel>
                                                        <Border x:Name="Badge" DockPanel.Dock="Right" Padding="5 1" CornerRadius="4" Background="{StaticResource Accent}" Visibility="Collapsed" VerticalAlignment="Center">
                                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="#1C1400" />
                                                        </Border>
                                                        <TextBlock x:Name="T" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{StaticResource Surface}" />
                                                    <Setter TargetName="T" Property="Foreground" Value="#F3EDE0" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding HasNew}" Value="True">
                                                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#2A2B30" />
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="T" Property="Foreground" Value="#F3EDE0" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>

    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Title bar: same surface as the window, drag anywhere on it-->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
            <Rectangle Width="15" Height="15" Margin="14 0 9 0" Fill="{StaticResource Accent}" VerticalAlignment="Center">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{StaticResource ICON_GREATSWORD}" Stretch="Uniform" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock x:Name="TitleText" Text="Aether" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#D8D0BE" />
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="8 1 0 0" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--Navigation: every page of the window is one click away, and the layout button is always in reach-->
            <Border Grid.Column="0" Background="#0D0E10" BorderBrush="{StaticResource Stroke}" BorderThickness="0 0 1 0">
                <DockPanel Margin="10 6 10 12">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0 8 0 0" DataContext="{x:Static viewModels:OverlayViewModel.Instance}">
                        <ToggleButton x:Name="EditButton" IsChecked="{Binding CanManipulateWindows, Mode=TwoWay}" Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="B" CornerRadius="8" Padding="12 8" Background="{StaticResource Accent}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <TextBlock x:Name="T" Text="Edit layout" FontWeight="SemiBold" Foreground="#1C1400" HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="T" Property="Text" Value="Done" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="B" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="2 8 2 0" LineHeight="15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter Property="Text" Value="{Binding EditKeyName, StringFormat='Or press {0} in game.'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanManipulateWindows}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter Property="Text" Value="Drag to move. Drag the corner or scroll to resize, Ctrl+scroll for small steps. Double-click resets the size. Hold Shift to turn off snapping. Esc or Done when finished." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Reset layout" Click="ResetLayout_Click" Style="{StaticResource LinkButton}" Margin="0 4 0 0"
                                ToolTip="Put every widget back in its default spot and size" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="12" Foreground="{StaticResource Muted}" Margin="12 8 0 6" />
                            <ItemsControl ItemsSource="{Binding Categories}" />
                            <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="8 8 8 8" />
                            <ContentControl Content="{Binding LogCategory}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--Page-->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--Header: the page's name, and search over every setting. Its edge line fades in only once the page is scrolled.-->
                <Border Grid.Row="0" Padding="24 12 24 10">
                    <DockPanel>
                        <TextBox x:Name="SettingsSearch" DockPanel.Dock="Right" Width="260" Height="30" VerticalAlignment="Center" FontSize="13"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="SettingsSearch_KeyDown"
                             Background="{StaticResource Surface}" Foreground="#F3EDE0" CaretBrush="{StaticResource Accent}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Box" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid Margin="10 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" Margin="0 1 8 0" />
                                        <!--2 px in: the text box starts its text (and caret) 2 px into its area-->
                                        <TextBlock x:Name="Hint" Grid.Column="1" Text="Search settings" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Margin="2 0 0 0" IsHitTestVisible="False" Visibility="Collapsed" />
                                        <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border x:Name="HeaderLine" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Stroke}" Opacity="0" IsHitTestVisible="False" />

                <!--Shows for the few options that need a restart; stays put while the page scrolls-->
                    <Border Margin="24 0 24 10" Padding="14 8" CornerRadius="10" Background="#26E2C27A" BorderBrush="#66E2C27A" BorderThickness="1"
                            Visibility="{Binding NeedsRestart, Converter={StaticResource A_Converter_BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Restart now" Command="{Binding RestartCommand}" Style="{StaticResource PillButton}" Background="{StaticResource Accent}" Foreground="#1C1400" />
                            <TextBlock Text="{Binding RestartReason}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>



                <!--Settings-->
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="SettingsScroll_ScrollChanged"
                              Visibility="{Binding IsSettingsShown, Converter={StaticResource A_Converter_BoolToVisibility}}">
                    <StackPanel Margin="24 4 18 24">
            <Border x:Name="UpdateCard" Margin="0 0 0 12" Padding="14 9" CornerRadius="10" Background="#1FE2C27A" BorderBrush="#59E2C27A" BorderThickness="1"
                    DataContext="{x:Static viewModels:UpdateViewModel.Instance}"
                    Visibility="{Binding IsVisible, Converter={StaticResource A_Converter_BoolToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12 0 0 0">
                            <Button Content="{Binding DismissLabel}" Command="{Binding DismissCommand}" Style="{StaticResource PillButton}" Margin="0 0 8 0"
                                    Visibility="{Binding CanDismiss, Converter={StaticResource A_Converter_BoolToVisibility}}" />
                            <Button Content="Try again" Command="{Binding RetryCommand}" Style="{StaticResource PillButton}" Background="{StaticResource Accent}" Foreground="#1C1400"
                                    Visibility="{Binding CanRetry, Converter={StaticResource A_Converter_BoolToVisibility}}" />
                            <Button Content="Restart now" Command="{Binding RestartCommand}" Style="{StaticResource PillButton}" Background="{StaticResource Accent}" Foreground="#1C1400"
                                    Visibility="{Binding CanRestart, Converter={StaticResource A_Converter_BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0 2 0 0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0 10 0 0"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource A_Converter_BoolToVisibility}}" />
                    <StackPanel Margin="0 10 0 0" Visibility="{Binding HasNotes, Converter={StaticResource A_Converter_BoolToVisibility}}">
                        <TextBlock Text="What's new" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0 0 0 4" />
                        <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NoteSections}" Margin="0 0 8 0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0 0 0 10">
                                            <TextBlock x:Name="Heading" Text="{Binding Version}" FontWeight="SemiBold" FontSize="13" Margin="0 0 0 2" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#D8D0BE" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Version}" Value="{x:Null}">
                                                <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0 0 0 12" Padding="14 8" CornerRadius="10" Background="#1FE0705A" BorderBrush="#59E0705A" BorderThickness="1"
                    DataContext="{x:Static core:Problems.Instance}"
                    Visibility="{Binding HasAny, Converter={StaticResource A_Converter_BoolToVisibility}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0 2">
                                    <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissCommand}" Style="{StaticResource PillButton}" Margin="12 0 0 0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="The Log tab has the details." Foreground="{StaticResource Muted}" FontSize="12" Margin="0 4 0 0" />
                </StackPanel>
            </Border>


                        <TextBlock Text="No settings match your search. Try a shorter word, or pick a page on the left." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2 4 0 0"
                                   Visibility="{Binding NoResults, Converter={StaticResource A_Converter_BoolToVisibility}}" />
                        <Grid x:Name="SettingsCard" RenderTransformOrigin="0.5,0">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Border CornerRadius="10" Background="{StaticResource Surface}" behaviors:RoundClip.Radius="10">
                            
                        <ItemsControl ItemsSource="{Binding Settings}" Margin="4 4 4 2">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <!--A bare container: the header, then the rows at the section's full width (the default one added an offset on one side)-->
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ContentPresenter />
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="14 12 0 4">
                                                <TextBlock.Visibility>
                                                    <MultiBinding Converter="{StaticResource AnyShown}">
                                                        <Binding Path="Items" />
                                                        <Binding Path="SearchVersion" Source="{x:Static viewModels:SettingsViewModel.Instance}" />
                                                        <Binding Path="IsSearching" Source="{x:Static viewModels:SettingsViewModel.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:Setting}">
                                    <Border x:Name="Row" Padding="14 10" MinHeight="48" CornerRadius="8" Margin="0 0 0 2" MouseEnter="SettingRow_MouseEnter" MouseLeave="SettingRow_MouseLeave" Visibility="{Binding IsShown, Converter={StaticResource A_Converter_BoolToVisibility}}" Background="Transparent"
                                            IsEnabled="{Binding IsEnabled}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel>
                                            <!--A few choices side by side: the current one is gold-->
                                            <Border x:Name="Choices" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16 0 0 0" Padding="2" CornerRadius="8" Background="#111214" Visibility="Collapsed">
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type core:SettingOption}">
                                                            <Button Command="{Binding Select}" Cursor="Hand" Focusable="False">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="B" CornerRadius="6" Padding="10 4" Background="Transparent">
                                                                            <TextBlock x:Name="T" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="T" Property="Foreground" Value="#F3EDE0" />
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="B" Property="Background" Value="{StaticResource Accent}" />
                                                                                <Setter TargetName="T" Property="Foreground" Value="#1C1400" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <CheckBox x:Name="Switch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16 0 0 0" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding Value, Mode=TwoWay}" Command="{Binding TriggerAction}" />
                                            <Button x:Name="Action" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16 0 0 0" Visibility="Collapsed"
                                                    Content="{Binding ActionLabel}" Command="{Binding TriggerAction}" Style="{StaticResource PillButton}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <!--Vector "i" in a solid circle on whole pixels: the icon-font glyph blurred into a ring and a line at this size.
                                                        The transparent padding gives the explanation tooltip a comfortable hover target.-->
                                                    <!--Defaults go in styles: a value set on the element itself would beat the hover triggers below-->
                                                    <Border x:Name="InfoMark" Background="Transparent" Padding="5 3" Margin="2 0 0 0" VerticalAlignment="Center" Cursor="Help"
                                                            ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="50" ToolTipService.ShowDuration="60000">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </Style>
                                                        </Border.Style>
                                                        <Path x:Name="InfoGlyph" Width="14" Height="14" SnapsToDevicePixels="True"
                                                              Data="F0 M7,0 A7,7 0 1 1 7,14 A7,7 0 1 1 7,0 Z M6,3 H8 V5 H6 Z M6,6 H8 V11 H6 Z">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="{StaticResource Muted}" />
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                    <!--Until the row has been looked at or changed-->
                                                    <Border x:Name="NewBadge" Margin="6 0 0 0" Padding="6 1" CornerRadius="4" Background="{StaticResource Accent}" Visibility="Collapsed" VerticalAlignment="Center">
                                                        <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="#1C1400" />
                                                    </Border>
                                                    <Border x:Name="RestartChip" Margin="8 0 0 0" Padding="6 1" CornerRadius="4" Background="#2A2B30" Visibility="Collapsed" VerticalAlignment="Center">
                                                        <TextBlock Text="Restart" FontSize="11" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="Detail" Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0 3 0 0" LineHeight="16" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsToggle}" Value="False">
                                            <Setter TargetName="Switch" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Action" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter TargetName="NewBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                            <Setter TargetName="RestartChip" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                            <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasMore}" Value="False">
                                            <Setter TargetName="InfoMark" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Choices" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!--Needs another toggle first-->
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="InfoMark" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                        <Trigger SourceName="InfoMark" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="InfoMark" Property="Opacity" Value="1" />
                                            <Setter TargetName="InfoGlyph" Property="Fill" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Border>
                            <Border CornerRadius="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--Log-->
                <Border x:Name="LogPanel" Grid.Row="1" Grid.RowSpan="2" Margin="24 4 24 20" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="4"
                        Visibility="{Binding IsLogShown, Source={x:Static viewModels:SettingsViewModel.Instance}, Converter={StaticResource A_Converter_BoolToVisibility}}">
                    <controls:ScrollingTextBox x:Name="LogBox" Text="{Binding Output}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                               Background="Transparent" Foreground="#D8D0BE" BorderThickness="0" Padding="8"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
