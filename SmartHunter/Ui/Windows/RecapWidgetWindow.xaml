<windows:WidgetWindow
        x:Class="SmartHunter.Ui.Windows.RecapWidgetWindow"                          
        Left="{Binding RecapWidget.X, Mode=TwoWay}"
        Top="{Binding RecapWidget.Y, Mode=TwoWay}"
    
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
                      
        xmlns:windows="clr-namespace:SmartHunter.Core.Windows"
        xmlns:viewModels="clr-namespace:SmartHunter.Game.Data.ViewModels"
    
        Title="Hunt recap"
                      
        d:DataContext="{x:Static viewModels:OverlayViewModel.Instance}"        
        MouseDown="WidgetWindow_MouseDown"
        MouseWheel="WidgetWindow_MouseWheel"
        ShowActivated="False"        
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#01000000"        
        SizeToContent="WidthAndHeight" 
        Width="250"
        Height="100">

    <Grid Name="Root" UseLayoutRounding="True" Margin="25" MinWidth="50" MinHeight="50">
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform>
                    <ScaleTransform.ScaleX>
                        <MultiBinding Converter="{StaticResource A_Converter_Multiply}">
                            <Binding Path="RecapWidget.Scale" />
                            <Binding Path="UiScale" />
                        </MultiBinding>
                    </ScaleTransform.ScaleX>
                    <ScaleTransform.ScaleY>
                        <MultiBinding Converter="{StaticResource A_Converter_Multiply}">
                            <Binding Path="RecapWidget.Scale" />
                            <Binding Path="UiScale" />
                        </MultiBinding>
                    </ScaleTransform.ScaleY>
                </ScaleTransform>
            </Grid.LayoutTransform>

            <!--Edit mode: the room this widget takes when it's full, so it can be placed before anything is in it-->
            <Grid Style="{StaticResource A_Style_EditPreview}" Width="480" Height="330">
                <Rectangle Style="{StaticResource A_Style_EditPreviewOutline}" />
                <TextBlock Style="{StaticResource T_EditPreview}" Text="Quest results, shown when a quest ends" />
            </Grid>

            <Grid Visibility="{Binding IsVisible, Converter={StaticResource A_Converter_BoolToVisibility}}">
                <ContentControl DataContext="{Binding RecapWidget.Context}" Content="{Binding}" />
            </Grid>
        </Grid>

        <Border Style="{StaticResource A_Style_EditFrame}">
            <Border Style="{StaticResource A_Style_EditLabel}">
                <TextBlock Style="{StaticResource T_EditLabel}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}  ·  {3}">
                        <Binding Source="Hunt recap" />
                        <Binding ElementName="Root" Path="ActualWidth" />
                        <Binding ElementName="Root" Path="ActualHeight" />
                        <Binding Path="RecapWidget.Scale" Converter="{StaticResource A_Converter_FractionToPercentage}" Mode="OneWay" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            </Border>
        </Border>
    </Grid>
</windows:WidgetWindow>
